{
  "name": "apphackathon",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "eslint . && pnpm -r --if-present lint",
    "test": "pnpm -r --if-present test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:push": "supabase db push",
    "db:push:dry": "supabase db push --dry-run",
    "db:seed": "node scripts/seed-remote.mjs",
    "test:db": "supabase test db --remote",
    "test:concurrency": "node --env-file=.env scripts/concurrency-test.mjs",
    "gen:types": "supabase gen types typescript --linked --schema public > packages/shared/src/database.types.ts",
    "supabase": "supabase"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "supabase": "^3.0.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
