# Kopieren nach .env (Root) und ausfüllen. .env wird nie committet.
# Werte: Supabase-Dashboard → Project Settings → API / Database.

# --- Gehostetes Dev-Projekt -------------------------------------------------
SUPABASE_PROJECT_REF=syrdvvxtllgutvonuwzd
SUPABASE_URL=https://syrdvvxtllgutvonuwzd.supabase.co
# Öffentlicher Schlüssel (publishable/anon) – darf in Clients
SUPABASE_PUBLISHABLE_KEY=
# Geheimer Schlüssel (secret/service_role) – NUR für Skripte (Seed, Tests), nie in App/Web-Code
SUPABASE_SECRET_KEY=
# Datenbank-Passwort (für supabase link / db push / test db)
SUPABASE_DB_PASSWORD=

# --- Edge Functions (Secrets per `pnpm supabase secrets set`) --------------
# Kontakt im Nominatim-User-Agent (Nutzungsregeln OSM). Platzhalter – vor Livegang ersetzen.
NOMINATIM_CONTACT_EMAIL=kontakt@example.com

# --- Auth-Provider (für die App-Session, in config.toml/Dashboard) ---------
SUPABASE_AUTH_EXTERNAL_APPLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_APPLE_SECRET=
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# Apps haben eigene .env-Dateien (apps/web/.env.local, apps/mobile/.env) mit
# NEXT_PUBLIC_SUPABASE_URL / EXPO_PUBLIC_SUPABASE_URL usw. – siehe deren README.
